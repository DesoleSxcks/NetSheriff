{
  "name": "netsheriff-back",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --watch prisma --exec node src/server.js",
    "dev:local": "npm run dev",
    "start": "node src/server.js",
    "prisma": "prisma",
    "setup:local": "node scripts/create-env-if-missing.js && mkdir -p data && npm run db:generate && npm run db:migrate && npm run db:seed",
    "setup:iptables": "sudo bash scripts/setup-iptables-permission.sh",
    "check:iptables": "bash scripts/check-iptables-permission.sh",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.0.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "16.3.1",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.0",
    "winston": "^3.9.0"
  },
  "devDependencies": {
    "nodemon": "3.0.1",
    "prisma": "^7.0.0"
  }
}
